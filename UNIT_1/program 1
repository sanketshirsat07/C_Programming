#include <stdio.h>
int main() {
    int age;
    float height;
    double salary;
    char grade;
    printf("Enter your age: ");
    scanf("%d" , &age);
    printf("Enter your height: ");
    scanf("%f" , &height);
    printf("Enter your salary: ");
    scanf("%lf" , &salary);
    printf("Enter your grade: ");
    scanf(" %c" , &grade);
    printf("\nDetails\n");
    printf("Age: %d\n", age);
    printf("Height: %.2f\n" , height);
    printf("Salary: %.2f\n" , salary);
    printf("Grade: %c\n" , grade);
    return 0;
}